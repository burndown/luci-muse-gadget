#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

CODE=/usr/lib/musegadget
STATE=/etc/musegadget

start_service() {
	local enabled run_as caps control disable shell files

	config_load musegadget
	config_get_bool enabled main enabled 0
	config_get run_as main run_as muse
	config_get caps main capability ""
	config_get control main control_service ""
	config_get_bool shell main allow_shell 1
	config_get_bool files main allow_files 1

	[ "$enabled" = 1 ] || return 0

	if [ ! -s "$STATE/pairing.json" ]; then
		logger -t musegadget "not paired yet, import a pairing bundle first"
		return 0
	fi

	# Muse runs commands as this account, so never fall back to root.
	case "$run_as" in
		""|root) logger -t musegadget "run_as must not be root"; return 1 ;;
	esac
	if ! id "$run_as" >/dev/null 2>&1; then
		useradd -M -s /bin/bash "$run_as" || return 1
	fi
	mkdir -p "/home/$run_as"
	chown "$run_as" "/home/$run_as"

	# Generic SDK commands can be switched off so that only named capabilities remain.
	disable=""
	[ "$shell" = 1 ] || disable="$disable system.run"
	[ "$files" = 1 ] || disable="$disable file.read file.write"

	procd_open_instance
	procd_set_param command /usr/bin/python3 -m musegadget_router run --run-as "$run_as"
	procd_set_param env \
		PYTHONPATH="$CODE:$CODE/lib" \
		MUSEGADGET_STATE_DIR="$STATE" \
		MUSEGADGET_SOCKET=/var/run/musegadget.sock \
		HOME="/home/$run_as" \
		MUSEGADGET_CAPS="$caps" \
		MUSEGADGET_CONTROL_SERVICES="$control" \
		MUSEGADGET_DISABLE="$disable" \
		PYTHONUNBUFFERED=1
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger musegadget
}
